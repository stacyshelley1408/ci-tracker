# AI classification (set one or both — Gemini is checked first)
GEMINI_API_KEY=         # get a free key at aistudio.google.com
GEMINI_MODEL=           # optional override; leave blank to use gemini-3.1-flash-lite
ANTHROPIC_API_KEY=      # optional — Claude Haiku fallback

# Reddit OAuth (REQUIRED — Reddit rejects unauthenticated API requests, and
# authenticated traffic is metered by token instead of by the GitHub Actions IP).
# Create a "script" app at https://www.reddit.com/prefs/apps for non-commercial
# use under ~100 req/min. REDDIT_USERNAME is required by Reddit's policy for the
# User-Agent contact string (platform:appname:version (by /u/username)).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=        # your Reddit username (no u/ prefix)

# Email alerts and digest
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=          # Gmail app password (not your login password)
ALERT_EMAIL=you@example.com
