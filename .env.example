# AI classification (set one or both — Gemini is checked first)
GEMINI_API_KEY=         # get a free key at aistudio.google.com
GEMINI_MODEL=           # optional override; leave blank to use gemini-3.1-flash-lite
ANTHROPIC_API_KEY=      # optional — Claude Haiku fallback

# Reddit OAuth (optional but strongly recommended on CI — metered by token, not
# IP, so it avoids the GitHub Actions IP rate-limiting). Create a "script" app
# at https://www.reddit.com/prefs/apps and use its client id + secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Email alerts and digest
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=          # Gmail app password (not your login password)
ALERT_EMAIL=you@example.com
